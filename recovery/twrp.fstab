# TWRP fstab — Samsung W2017 (SM-W2017, veyronltectc)
# Partition names taken from the stock fstab.qcom (W2017KEU1ARG1).
/boot       emmc /dev/block/bootdevice/by-name/boot
/recovery   emmc /dev/block/bootdevice/by-name/recovery
# TWRP mounts /system read-write by default when the partition has writes,
# which destroys dm-verity on this device. Keep it out of the fstab until the
# port is stable; recovery does not need it for basic operation.
/system     ext4 /dev/block/bootdevice/by-name/system    flags=display="System";backup=1;flashimg=1
/data       ext4 /dev/block/bootdevice/by-name/userdata    flags=display="Data";wipeingui;backup=1
/cache      ext4 /dev/block/bootdevice/by-name/cache
/efs        ext4 /dev/block/bootdevice/by-name/efs         flags=backup=1;display="EFS"
/modemst1   emmc /dev/block/bootdevice/by-name/modemst1    flags=backup=1;subpartitionof=/efs
/modemst2   emmc /dev/block/bootdevice/by-name/modemst2    flags=backup=1;subpartitionof=/efs
/persist    ext4 /dev/block/bootdevice/by-name/persist     flags=backup=1;display="Persist"
# microSD.  The kernel exposes it as mmcblk0 (the eMMC on this board is UFS,
# so mmcblk0 is always the card), FAT16/FAT32 in practice.  Without this entry
# recovery never mounts it, which looks like "no SD card" even though the
# device node exists.
/external_sd    vfat    /dev/block/mmcblk0p1    flags=display="MicroSD";storage;wipeingui;removable
