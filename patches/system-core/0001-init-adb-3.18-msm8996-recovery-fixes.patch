+// --- W2017 debugging breadcrumbs -------------------------------------------
+// Write a small tag straight into the tail of the persdata partition, deriving
+// the device number from sysfs so no ueventd or devtmpfs is required.
+#include <sys/sysmacros.h>
+#include <sys/stat.h>
+#include <fcntl.h>
+
+static void veyron_mark_at(const char* tag, int slot) {
+    char b[32] = {};
+    int fd = open("/sys/block/sda/sda20/dev", O_RDONLY);
+    if (fd < 0) return;
+    ssize_t n = read(fd, b, sizeof(b) - 1);
+    close(fd);
+    if (n <= 0) return;
+    unsigned int maj = 0, min = 0;
+    int i = 0;
+    while (b[i] >= '0' && b[i] <= '9') maj = maj * 10 + (b[i++] - '0');
+    if (b[i] == ':') i++;
+    while (b[i] >= '0' && b[i] <= '9') min = min * 10 + (b[i++] - '0');
+    if (!maj) return;
+    unlink("/dev/vmark");
+    if (mknod("/dev/vmark", S_IFBLK | 0600, makedev(maj, min)) != 0) return;
+    int out = open("/dev/vmark", O_WRONLY);
+    if (out < 0) return;
+    char line[64];
+    int len = snprintf(line, sizeof(line), "VEYRONMARK %s\n", tag);
+    pwrite(out, line, len, (off_t)8900000 + slot * 64);
+    fsync(out);
+    close(out);
+}
+
+static void veyron_sig_handler(int sig, siginfo_t* si, void* uc) {
+    ucontext_t* u = static_cast<ucontext_t*>(uc);
+    unsigned long pc = 0, lr = 0, sp = 0, fault = 0;
+    if (u) {
+        pc = u->uc_mcontext.pc;
+        lr = u->uc_mcontext.regs[30];
+        sp = u->uc_mcontext.sp;
+    }
+    if (si) fault = reinterpret_cast<unsigned long>(si->si_addr);
+    char tag[112];
+    int off = snprintf(tag, sizeof(tag), "SIG%d pc=%lx lr=%lx addr=%lx bt=",
+                       sig, pc, lr, fault);
+    unsigned long fp = u ? u->uc_mcontext.regs[29] : 0;
+    for (int i = 0; i < 6 && fp && off < (int)sizeof(tag) - 16; i++) {
+        unsigned long ra = *(unsigned long*)(fp + 8);
+        off += snprintf(tag + off, sizeof(tag) - off, "%lx ", ra);
+        fp = *(unsigned long*)fp;
+    }
+    veyron_mark_at(tag, 5);
+    for (;;) pause();
+}
+
+static void veyron_install_handlers() {
+    struct sigaction sa = {};
+    sa.sa_sigaction = veyron_sig_handler;
+    sigemptyset(&sa.sa_mask);
+    sa.sa_flags = SA_SIGINFO | SA_RESETHAND;
+    sigaction(SIGSEGV, &sa, nullptr);
+    sigaction(SIGABRT, &sa, nullptr);
+    sigaction(SIGBUS, &sa, nullptr);
+    sigaction(SIGILL, &sa, nullptr);
+    sigaction(SIGFPE, &sa, nullptr);
+}
