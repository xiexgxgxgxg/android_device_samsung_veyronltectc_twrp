+// Fallback logger used only on fatal errors: write the message straight into
+// the tail of persdata, deriving the device number from sysfs so it works even
+// when ueventd never ran and /dev has no block nodes.
+static void WriteFatalToPersdata(const char* msg) {
+    char devbuf[32] = {};
+    int fd = open("/sys/block/sda/sda20/dev", O_RDONLY);
+    if (fd < 0) return;
+    ssize_t n = read(fd, devbuf, sizeof(devbuf) - 1);
+    close(fd);
+    if (n <= 0) return;
+    unsigned int maj = 0, min = 0;
+    if (sscanf(devbuf, "%u:%u", &maj, &min) != 2) return;
+    unlink("/dev/veyronlog");
+    if (mknod("/dev/veyronlog", S_IFBLK | 0600, makedev(maj, min)) != 0) return;
+    int out = open("/dev/veyronlog", O_WRONLY);
+    if (out < 0) return;
+    char line[512];
+    int len = snprintf(line, sizeof(line), "VEYRONFATAL uptime0=%d %s\n", (int)time(nullptr), msg);
+    if (len > 0) {
+        pwrite(out, line, len, (off_t)8912896);
+        fsync(out);
+    }
+    close(out);
+}
+
 static void InitAborter(const char* abort_message) {
     // When init forks, it continues to use this aborter for LOG(FATAL), but we want children to
     // simply abort instead of trying to reboot the system.
@@ -41,25 +69,28 @@ static void InitAborter(const char* abort_message) {
     // DoReboot() does a lot to try to shutdown the system cleanly.  If something happens to call
     // LOG(FATAL) in the shutdown path, we want to catch this and immediately use the syscall to
     // reboot instead of recursing here.
-    static bool has_aborted = false;
-    if (!has_aborted) {
-        has_aborted = true;
-        // Do not queue "shutdown" trigger since we want to shutdown immediately and it's not likely
-        // that we can even run the ActionQueue at this point.
-        DoReboot(ANDROID_RB_RESTART2, "reboot", "bootloader", false);
-    } else {
-        RebootSystem(ANDROID_RB_RESTART2, "bootloader");
+    // DEBUG: do not reboot to the bootloader on a fatal error. Hang here
+    // instead so the kernel stays alive and its logger can persist the message.
+    LOG(ERROR) << "DEBUG_FATAL_HANG: init hit a fatal error, hanging instead of reboot";
+    WriteFatalToPersdata(abort_message);
+    for (;;) {
+        pause();
     }
 }
 
 void InitKernelLogging(char* argv[]) {
     // Make stdin/stdout/stderr all point to /dev/null.
     int fd = open("/sys/fs/selinux/null", O_RDWR);
+    if (fd == -1) {
+        // pisces: this 3.4 kernel may not provide selinuxfs; fall back to /dev/null.
+        mknod("/dev/null", S_IFCHR | 0666, makedev(1, 3));
+        fd = open("/dev/null", O_RDWR);
+    }
     if (fd == -1) {
         int saved_errno = errno;
         android::base::InitLogging(argv, &android::base::KernelLogger, InitAborter);
         errno = saved_errno;
-        PLOG(FATAL) << "Couldn't open /sys/fs/selinux/null";
+        PLOG(FATAL) << "Couldn't open /dev/null";
     }
     dup2(fd, 0);
     dup2(fd, 1);
